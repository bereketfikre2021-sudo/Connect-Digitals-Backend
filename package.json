{
  "name": "cdpromo-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Connect Digitals Promotion Platform — Backend (API + Bot)",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev:api":           "node --env-file=.env node_modules/tsx/dist/cli.mjs src/index.ts",
    "dev:bot":           "node --env-file=.env node_modules/tsx/dist/cli.mjs src/bot/index.ts",
    "build":             "tsc --project tsconfig.json",
    "start":             "node dist/index.js",
    "start:bot":         "node dist/bot/index.js",
    "typecheck":         "tsc --noEmit",
    "test":              "node node_modules/vitest/dist/cli.js run tests/unit",
    "test:watch":        "node node_modules/vitest/dist/cli.js tests/unit",
    "db:generate":       "prisma generate",
    "db:migrate":        "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed":           "tsx prisma/seed.ts",
    "db:studio":         "prisma studio",
    "db:validate":       "prisma validate",
    "db:format":         "prisma format"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@supabase/supabase-js": "2.49.4",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "grammy": "1.31.0",
    "helmet": "8.0.0",
    "multer": "1.4.5-lts.1",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/multer": "1.4.12",
    "@types/node": "22.13.10",
    "prisma": "6.5.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
