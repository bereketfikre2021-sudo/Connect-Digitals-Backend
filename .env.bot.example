# =============================================================================
# Connect Digitals — Bot Environment Variables
# Used by: npm run start:bot  (production)
#          npm run dev:bot     (development)
# Copy to .env.bot — NEVER commit .env.bot to version control
# =============================================================================

NODE_ENV=production

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Webhook (production only) ─────────────────────────────────────────────────
# The public HTTPS URL Telegram will POST updates to.
# Must be https:// and point to THIS bot process (e.g. https://bot.example.com)
# NOT the same URL as the API — this is the bot's own public address.
TELEGRAM_WEBHOOK_URL=https://bot.example.com

# A random secret string (min 32 chars) sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
# Generate with: openssl rand -hex 32
# Must match on both the Telegram registration and this server.
TELEGRAM_WEBHOOK_SECRET=

# Port this bot HTTP server listens on (default: 3001)
BOT_PORT=3001

# ── Mini App URL ──────────────────────────────────────────────────────────────
# Shown in the /start command WebApp button
MINI_APP_URL=https://your-api.example.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
