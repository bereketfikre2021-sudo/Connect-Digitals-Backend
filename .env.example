# =============================================================================
# Connect Digitals — Backend Environment Variables
# Copy to .env — NEVER commit .env to version control
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Transaction Pooler URL (port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY — server-side only, NEVER expose to browser or frontend
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
# From @BotFather — server-side only, never logged or sent to clients
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Webhook URL — public HTTPS URL that receives Telegram updates (production only)
# Example: https://connect-digitals-api.onrender.com/bot/webhook
TELEGRAM_WEBHOOK_URL=
# Optional webhook secret — random string you provide to @BotFather as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ── Telegram Admin IDs ────────────────────────────────────────────────────────
# Comma-separated Telegram numeric user IDs that can use admin bot commands
# such as /broadcast. Get a user's numeric ID from @userinfobot on Telegram.
# Example: TELEGRAM_ADMIN_IDS=123456789,987654321
# SECURITY: authorization is enforced server-side. This is not exposed to any
# frontend. Security does NOT rely on command visibility.
TELEGRAM_ADMIN_IDS=348691920

# ── App URLs ──────────────────────────────────────────────────────────────────
# The public HTTPS URL of the deployed Mini App (Vercel, Netlify, etc.)
MINI_APP_URL=https://your-mini-app.vercel.app
ADMIN_URL=https://your-admin.netlify.app
# Comma-separated — must include admin dashboard, mini-app, and any dev origins
CORS_ALLOWED_ORIGINS=https://your-mini-app.vercel.app,https://your-admin.netlify.app,http://localhost:5173,http://localhost:5174

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Used by prisma/seed.ts to create the first SUPER_ADMIN account
# Remove or leave blank after initial seed
ADMIN_BOOTSTRAP_EMAIL=admin@connectdigitals.com
ADMIN_BOOTSTRAP_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────
# Production: info or warn. Development: debug
LOG_LEVEL=info

# ── Ad provider credentials (future / optional) ───────────────────────────────
# None of these are required for manual fulfillment.
# Only set when the corresponding provider integration is active.
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
